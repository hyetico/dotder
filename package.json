{
  "name": "dotder",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "mkdir -p .next && xattr -w 'com.apple.fileprovider.ignore#P' 1 .next 2>/dev/null || true",
    "dev": "next dev",
    "prebuild": "mkdir -p .next && xattr -w 'com.apple.fileprovider.ignore#P' 1 .next 2>/dev/null || true",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write src",
    "format:check": "prettier --check src",
    "setup": "mkdir -p node_modules && (xattr -w 'com.apple.fileprovider.ignore#P' 1 node_modules 2>/dev/null || true) && npm install",
    "postinstall": "xattr -w 'com.apple.fileprovider.ignore#P' 1 node_modules 2>/dev/null || true"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.101.4",
    "lucide-react": "^1.33.0",
    "next": "16.3.1",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.1",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
